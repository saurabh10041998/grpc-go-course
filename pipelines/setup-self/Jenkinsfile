pipeline {
    agent any

    stages {
        stage('install') {
            steps {
                sh '''
                    apt-get update -y
                    apt-get install -y sshpass
                    apt-get install -y python3 python3-pip
                    pip3 install ansible
                '''
            }
        }

        stage('verify') {
            steps {
                sh '''
                    echo "=== Verifying sshpass ==="
                    sshpass -V

                    echo "=== Verifying python3 ==="
                    python3 --version

                    echo "=== Verifying pip3 ==="
                    pip3 --version

                    echo "=== Verifying ansible ==="
                    ansible --version
                '''
            }
        }
    }
}
